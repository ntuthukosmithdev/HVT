# Canonical site URL used for metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.hvt.co.za

# Enquiry form delivery (Resend, https://resend.com)
# Until both RESEND_API_KEY and ENQUIRY_FROM_EMAIL are set, the form tells
# visitors their enquiry was NOT sent and offers email/phone instead.
RESEND_API_KEY=
# Sender on a domain verified in Resend
ENQUIRY_FROM_EMAIL="HVT Website <website@hvt.co.za>"
# Inbox that receives enquiries (defaults to info@hvt.co.za)
ENQUIRY_TO_EMAIL=info@hvt.co.za

# Optional: skip Turbopack's filesystem cache (useful on network drives)
# NEXT_DISABLE_FS_CACHE=1
